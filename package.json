{
  "name": "local-factory",
  "version": "0.3.0",
  "description": "A local app for handing coding tasks to Codex, Claude, and OpenCode in isolated Git worktrees",
  "license": "MIT",
  "author": "Nika Siradze",
  "homepage": "https://github.com/nmbrthirteen/local-factory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nmbrthirteen/local-factory.git"
  },
  "bugs": {
    "url": "https://github.com/nmbrthirteen/local-factory/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.10",
  "engines": {
    "bun": ">=1.2.10"
  },
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun run build && bun server.ts",
    "ui": "bun --bun vite",
    "build": "bun --bun vite build",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web",
    "lint": "biome lint .",
    "check": "bun run lint && bun run typecheck && bun --bun vite build --logLevel warn",
    "test": "bun test ./test --timeout 30000",
    "test:browser": "bun test/browser.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "probe": "bun test/probe.ts"
  },
  "trustedDependencies": [
    "opencode-ai"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.268",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "opencode-ai": "1.18.30",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadow-plugin": "2.1.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.2.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
